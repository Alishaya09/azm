# Copy this file to .env in the project root and change the values you need.
# Any variable you leave out takes its default. Real environment variables override this file.
# start-azm.cmd / start-azm.sh already set the values used for the local model (port 5182, model on 8002, RAG on 8010).

# ===== Server =====
# Port (default 5173)
PORT=5173
# Listen address: 0.0.0.0 = reachable on the local network, 127.0.0.1 = this machine only
HOST=0.0.0.0
# Data folder (default: data inside the project)
# AZM_DATA_DIR=C:\azm-data
# Admin password, used once on the very first run only (when data/users.json does not exist yet)
# AZM_ADMIN_PASSWORD=<choose-a-strong-password>

# ===== Simulation =====
# Length of one operational hour in milliseconds (default 60000 = one real minute per operational hour)
AZM_HOUR_MS=60000
# How long simulated consumption is grouped before it is closed as a permanent log entry (default 3600000 = one real hour)
AZM_CONSUMPTION_BUCKET_MS=3600000

# ===== AI assistant (language model) =====
# none = not connected (default) | openai = any OpenAI-compatible server (Ollama, vLLM, LM Studio, llama.cpp, serve-mlx.py…)
AZM_AI_PROVIDER=none
# Server address, for example:
#   AZM (scripts/start-ai.sh): http://127.0.0.1:8002/v1
#   Ollama:                    http://localhost:11434/v1
#   vLLM:                      http://localhost:8000/v1
#   LM Studio:                 http://localhost:1234/v1
AZM_AI_BASE_URL=http://127.0.0.1:8002/v1
# Model name as the server knows it
AZM_AI_MODEL=azm-report-base
# API key, if the server needs one (leave empty for local models)
AZM_AI_API_KEY=
# Reply timeout in milliseconds
AZM_AI_TIMEOUT_MS=60000
# Randomness of replies (0 = fixed, 1 = creative)
AZM_AI_TEMPERATURE=0.3
# How many previous chat messages are sent to the model
AZM_AI_MAX_HISTORY=20
AZM_AI_MAX_TOKENS=768
# Character budget for the data snapshot, history and tool results (fits the 6144-token window of serve-mlx.py)
AZM_AI_CONTEXT_CHARS=14000
# Stream the reply to the browser while it is written: 1 = on (default), 0 = whole reply at once
AZM_AI_STREAM=1
# Automatic note at the end of a reply when it contains a number not found in the data (assistant and reports): 1 = on (default), 0 = off
AZM_AI_NUMBER_CHECK=1

# ===== Supply-request extractor to JSON (LoRA, separate from the general chat) =====
# Unset values fall back to AZM_AI_*. Extraction temperature is fixed at 0 on the server.
# Locally: the same start-ai.sh service on 8002, under the name azm-request-lora
AZM_REQUEST_AI_PROVIDER=none
AZM_REQUEST_AI_BASE_URL=http://127.0.0.1:8002/v1
AZM_REQUEST_AI_MODEL=azm-request-lora
AZM_REQUEST_AI_API_KEY=
AZM_REQUEST_AI_TIMEOUT_MS=180000
AZM_REQUEST_AI_MAX_TOKENS=512

# ===== Report model (separate from the chat model) =====
# The AI operations report and report explanations. Locally: the same 8002 service, under the name azm-report-base
AZM_REPORT_AI_PROVIDER=none
AZM_REPORT_AI_BASE_URL=http://localhost:8002/v1
AZM_REPORT_AI_MODEL=
AZM_REPORT_AI_API_KEY=
AZM_REPORT_AI_TIMEOUT_MS=60000
AZM_REPORT_AI_TEMPERATURE=0.2
AZM_REPORT_AI_MAX_HISTORY=12
AZM_REPORT_AI_MAX_TOKENS=1024
# Character budget for the operations-report data sent to the model
AZM_REPORT_AI_CONTEXT_CHARS=10000

# ===== RAG =====
# Optional RAG service (BGE-M3, scripts/start-rag.sh). Without it, the server uses a local search over the bundled AZM reference.
# AZM_RAG_URL=http://127.0.0.1:8010
